<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FileOrganizer.Gui.App"
             xmlns:local="using:FileOrganizer.Gui"
             xmlns:converters="using:FileOrganizer.Gui.Converters"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <converters:BoolToRowHighlightConverter x:Key="RowHighlightConverter"/>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
