@page
@model IndexModel
@{
    ViewData["Title"] = "FaceRank";
}

<div class="text-center py-5">
    <h1 class="display-3 fw-bold">FaceRank</h1>
    <p class="lead text-muted">Who do you prefer? Vote now.</p>
    <div class="row mt-5 justify-content-center g-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center py-5">
                    <h2 class="card-title h4">Add Yourself</h2>
                    <p class="card-text text-muted">Upload your photo and join the ranking</p>
                    <a asp-page="/Add" class="btn btn-primary btn-lg">Sign Up</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center py-5">
                    <h2 class="card-title h4">Vote</h2>
                    <p class="card-text text-muted">Pick who you prefer between two people</p>
                    <a asp-page="/Vote/Index" asp-route-gender="Male" class="btn btn-outline-primary btn-lg me-2">Men</a>
                    <a asp-page="/Vote/Index" asp-route-gender="Female" class="btn btn-outline-primary btn-lg">Women</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center py-5">
                    <h2 class="card-title h4">Leaderboard</h2>
                    <p class="card-text text-muted">See who's on top</p>
                    <a asp-page="/Leaderboard/Index" asp-route-gender="Male" class="btn btn-outline-primary btn-lg me-2">Men</a>
                    <a asp-page="/Leaderboard/Index" asp-route-gender="Female" class="btn btn-outline-primary btn-lg">Women</a>
                </div>
            </div>
        </div>
    </div>
    <div class="mt-5">
        <p class="text-muted small">Total contestants: <strong>@Model.TotalPeople</strong> &middot; Total votes: <strong>@Model.TotalVotes</strong></p>
    </div>
</div>
